{
  "manifest_version": 3,
  "name": "新标签页",
  "version": "1.0.1",
  "author": "lantianz",
  "description": "新标签页书签管理扩展，支持 WebDAV 刷新与本地缓存。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
